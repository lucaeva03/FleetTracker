@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using FleetTracker.Data
@using FleetTracker.Models.Events
@using System.Globalization
@inject AuthenticationStateProvider AuthStateProvider
@inject FleetTrackerDbContext dbContext

<PageTitle>Home - FleetTracker</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="H-welcome-page">
            <div class="H-welcome-header">
                <h1 class="H-welcome-title">FleetTracker</h1>
            </div>
            <div class="H-welcome-footer">
                <a href="/login" class="btn H-login-btn">Login</a>
            </div>
        </div>
    </NotAuthorized>

    <Authorized Context="auth">
        <div class="container mt-5">
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <h1 class="fw-bold display-4">
                        Benvenuto in <span class="H-text-green">FleetTracker</span>
                    </h1>
                </div>
            </div>

            @* questa sezione non viene mostrata agli utenti con ruolo "cliente" *@
            @if (!auth.User.IsInRole("cliente"))
            {
                <div class="row justify-content-center mb-3">
                    <div class="col-md-8">
                        <div class="card shadow-lg border-0 rounded-4 bg-light">
                            <div class="card-body p-4">
                                <div class="row align-items-center">
                                    <!-- Utente -->
                                    <div class="col text-start d-flex align-items-center">
                                        <i class="bi bi-person-fill text-primary fs-4 me-2"></i>
                                        <span class="fs-5"><strong>Utente:</strong> @auth.User.Identity?.Name</span>
                                    </div>
                                    <!-- Ruolo Centrato -->
                                    <div class="col text-center d-flex align-items-center justify-content-center">
                                        <i class="bi bi-shield-lock-fill text-success fs-4 me-2"></i>
                                        <span class="fs-5"><strong>Ruolo:</strong> @auth.User.FindFirst(ClaimTypes.Role)?.Value</span>
                                    </div>
                                    <!-- Logout -->
                                    <div class="col text-end">
                                        <a href="/logout" class="btn btn-danger btn-lg rounded-pill px-4 shadow-sm">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>


<AuthorizeView Roles="superadmin">
    <Authorized>
        <div class="container ">
            <!-- Nuovo header -->
            <div class="text-center mb-4">
                <h2 class="display-5 fw-bold gradient-text">
                    <i class="bi bi-people-fill me-2"></i>
                    Riepilogo Utenti
                </h2>
                <p class="text-muted fst-italic">
                    Panoramica completa di tutti gli account registrati
                </p>
            </div>

            <div class="row gx-4 gy-4 justify-content-center">
                @foreach (var card in new[]
                {
                ("Totale utenti", totalUsers, "bg-primary text-white", "bi-people-fill"),
                ("Superadmin", superadminCount, "bg-danger text-white", "bi-shield-lock-fill"),
                ("Admin", adminCount, "bg-warning text-dark", "bi-tools"),
                ("Dipendenti", dipendenteCount, "bg-success text-white", "bi-briefcase-fill"),
                ("Clienti", clienteCount, "bg-info text-dark", "bi-cart-fill")
                })
                {
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="card h-100 position-relative text-center @card.Item3 shadow-lg border-0">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <i class="bi @card.Item4 fs-1 mb-2"></i>
                                <h6 class="card-title mb-1">@card.Item1</h6>
                                <p class="display-6 fw-bold m-0">@card.Item2</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="admin">
    <Authorized>
        <div class="container mt-2">
            <div class="row mb-3 gx-4 gy-4">
                <!-- Statistiche Veicoli -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow border-0 rounded-4 h-100">
                        <div class="card-header bg-gradient-light p-3 rounded-top-4">
                            <h5 class="mb-0 text-company d-flex align-items-center justify-content-center">
                                <i class="bi bi-speedometer2 fs-3 me-2"></i>
                                <strong>Statistiche Veicoli</strong>
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted mb-3">Totale veicoli: <span class="fw-bold text-dark">@totalVehicles</span></p>
                            <ul class="list-unstyled mb-0">
                                @foreach (var stat in vehicleStats)
                                {
                                    var icon = stat.Label switch
                                    {
                                        "Deposito" => "bi-building",
                                        "Fuori deposito" => "bi-truck",
                                        "Manutenzione" => "bi-wrench",
                                        _ => "bi-bar-chart"
                                    };
                                    <li class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div><i class="bi @icon text-secondary me-1"></i><small>@stat.Label</small></div>
                                            <small class="fw-semibold">@stat.Percent.ToString("0.##")% </small>
                                        </div>
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar @stat.BarClass rounded-pill" role="progressbar"
                                                 style="width:@(stat.Percent.ToString(CultureInfo.InvariantCulture))%" aria-valuenow="@stat.Percent"
                                                 aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Statistiche Manutenzioni -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow border-0 rounded-4 h-100">
                        <div class="card-header bg-gradient-light p-3 rounded-top-4">
                            <h5 class="mb-0 text-company d-flex align-items-center justify-content-center">
                                <i class="bi bi-wrench-adjustable-circle fs-3 me-2"></i>
                                <strong>Statistiche Manutenzioni</strong>
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row text-center mb-2">
                                <div class="col-6 mb-3">
                                    <small class="d-block text-success fs-5">Programmata</small>
                                    <span class="badge bg-success rounded-pill fs-5">@(percentFutureProgrammed.ToString("0.##"))%</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <small class="d-block text-warning fs-5">Da fare oggi</small>
                                    <span class="badge bg-warning text-dark rounded-pill fs-5">@(percentDueToday.ToString("0.##"))%</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <small class="d-block text-danger fs-5">Scaduta</small>
                                    <span class="badge bg-danger rounded-pill fs-5">@(percentOverdue.ToString("0.##"))%</span>
                                </div>
                                <div class="col-6 mb-3">
                                    <small class="d-block text-secondary fs-5">Non Programmata</small>
                                    <span class="badge bg-secondary rounded-pill fs-5">@(percentNoFuture.ToString("0.##"))%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistiche Consegne -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow border-0 rounded-4 h-100">
                        <div class="card-header bg-gradient-light p-3 rounded-top-4">
                            <h5 class="mb-0 text-company d-flex align-items-center justify-content-center">
                                <i class="bi bi-truck fs-3 me-2"></i>
                                <strong>Statistiche Consegne</strong>
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted mb-3">Totale consegne: <span class="fw-bold text-dark">@totalDeliveries</span></p>
                            <div class="d-flex flex-column gap-3">
                                @foreach (var stat in deliveryStats)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <small>@stat.Label</small>
                                            <small class="fw-semibold">@stat.Percent.ToString("0.##")%</small>
                                        </div>
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar bg-company rounded-pill" role="progressbar"
                                                 style="width:@(stat.Percent.ToString(CultureInfo.InvariantCulture))%" aria-valuenow="@stat.Percent"
                                                 aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="dipendente">
    <Authorized>
        <div class="container dip-home-container mt-2">
            <!-- Header per dipendenti -->
            <div class="text-center mb-4">
                <h2 class="display-5 fw-bold gradient-text">
                    <i class="bi bi-person-badge me-2"></i>
                    La Tua Dashboard
                </h2>
                <p class="text-muted fst-italic">
                    Riepilogo dei tuoi dati di oggi
                </p>
            </div>

            <div class="row gx-4 gy-4 ali">
                <!-- Card 1: Veicolo assegnato e stato consumo -->
                <div class="col-md-4">
                    <div class="card shadow border-0 rounded-4 h-100">
                        <div class="card-header bg-gradient-light p-3 rounded-top-4">
                            <h5 class="mb-0 text-company">
                                <i class="bi bi-truck-flatbed fs-3 me-2"></i>
                                <strong>Veicolo di Oggi</strong>
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            @if (assignedVehicle != null)
                            {
                                <p><strong>@assignedVehicle.Veicolo?.targa</strong> – @assignedVehicle.Veicolo?.modello</p>
                                @if (consumptionExists)
                                {
                                    <span class="badge bg-success">Consumo inserito</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Consumo non inserito</span>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Nessun veicolo assegnato per oggi.</p>
                            }
                        </div>
                    </div>
                </div>
                <!-- Card 2: Destinazioni di oggi -->
                <div class="col-md-4">
                    <div class="card shadow border-0 rounded-4 h-100">
                        <div class="card-header bg-gradient-light p-3 rounded-top-4">
                            <h5 class="mb-0 text-company">
                                <i class="bi bi-geo-alt fs-3 me-2"></i>
                                <strong>Destinazioni di Oggi</strong>
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            @if (todaysDestinations.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var dest in todaysDestinations)
                                    {
                                        <li>@dest</li>
                                    }
                                    @if (hasMoreDestinations)
                                    {
                                        <li>…</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted">Nessuna destinazione per oggi.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="cliente">
    <Authorized>
        <div class="container-fluid delivery-page">
            <!-- Titolo Centrale Stilizzato -->
            <div class="row mb-5">
                <div class="col-12 text-center mb-2">
                    <div class="d-inline-flex align-items-center bg-company-light p-3 rounded-pill shadow-lg">
                        <i class="bi bi-truck display-5 text-company me-3"></i>
                        <h1 class="mb-0 text-company fw-bold fs-2">Le Mie Consegne</h1>
                    </div>
                </div>
            </div>

            <!-- Slider delle Consegne -->
            <div class="row gx-4 gy-4">
                <!-- Passate -->
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="card-header bg-success text-dark text-center py-2">
                            <i class="bi bi-clock-history fs-3"></i>
                            <h5 class="mb-0 mt-1">Passate</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 30vh; overflow-y: auto;">
                                @if (pastDeliveries.Any())
                                {
                                    <table class="table table-striped mb-0">
                                        <tbody>
                                            @foreach (var c in pastDeliveries)
                                            {
                                                <tr>
                                                    <td class="fw-semibold text-company">@c.c_id</td>
                                                    <td>@c.data_prevista.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <span class="badge @(c.stato == "consegnato" ? "bg-success" : "bg-secondary")">@c.stato</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted">Nessuna consegna passata</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Oggi -->
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="card-header bg-warning text-dark text-center py-2">
                            <i class="bi bi-calendar-day fs-3"></i>
                            <h5 class="mb-0 mt-1">Oggi (@DateTime.Today.ToString("dd/MM/yyyy"))</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 30vh; overflow-y: auto;">
                                @if (todaysDeliveries.Any())
                                {
                                    <table class="table table-hover mb-0">
                                        <tbody>
                                            @foreach (var c in todaysDeliveries)
                                            {
                                                <tr>
                                                    <td>@c.c_id</td>
                                                    <td>@(c.orario_previsto.HasValue ? c.orario_previsto.Value.ToString(@"hh\:mm") : "-")</td>
                                                    <td>
                                                        <span class="badge @(
                                                            c.stato == "in preparazione" ? "bg-secondary" :
                                                            c.stato == "in consegna" ? "bg-warning text-dark" :
                                                            "bg-success") text-uppercase">
                                                            @c.stato
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted">Nessuna consegna oggi</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Future -->
                <div class="col-md-4"> 
                    <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="card-header bg-info text-dark text-center py-2">
                            <i class="bi bi-calendar2-plus fs-3"></i>
                            <h5 class="mb-0 mt-1">Future</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 30vh; overflow-y: auto;">
                                @if (futureDeliveries.Any())
                                {
                                    <table class="table table-striped mb-0">
                                        <tbody>
                                            @foreach (var c in futureDeliveries)
                                            {
                                                <tr>
                                                    <td>@c.c_id</td>
                                                    <td>@c.data_prevista.ToString("dd/MM/yyyy")</td>
                                                    <td><span class="badge bg-light text-company">@c.stato</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted">Nessuna consegna futura</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> 

        <div class="mt-4">
            <div class="col-12 text-center" style="font-size:2.5vh">
                <p class="text-muted">Per assistenza contattare: <a href="mailto:help@fleettracker.com" class="text-company fw-semibold">help@fleettracker.com</a></p>
            </div>
        </div>

        <style>
            .bg-company-light {
                background-color: rgba(22,90,97,0.1);
            }

            .delivery-page i {
                font-size: 2.5rem;
            }

            .delivery-page .card-header h5 {
                font-size: 1rem;
            }
        </style>
    </Authorized>
</AuthorizeView>

