@code {
    // campi per il dipendente
    private int employeeId;
    private AssegnazioneVeicolo? assignedVehicle;
    private bool consumptionExists;
    private List<string> todaysDestinations = new();
    private bool hasMoreDestinations;

    // campi per superadmin / admin
    private int totalUsers, superadminCount, adminCount, dipendenteCount, clienteCount;
    private int totalVehicles;
    private List<StatItem> vehicleStats = new();
    private int countFutureProgrammed, countDueToday, countOverdue, countNoFuture;
    private double percentFutureProgrammed, percentDueToday, percentOverdue, percentNoFuture;
    private int totalDeliveries;
    private List<StatItem> deliveryStats = new();

    // campi per il cliente
    private int customerId;
    private List<Consegna> pastDeliveries = new();
    private List<Consegna> todaysDeliveries = new();
    private List<Consegna> futureDeliveries = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("dipendente"))
        {
            // recupero ID e dati di oggi
            var userName = user.Identity?.Name!;
            var utente = await dbContext.utenti.SingleAsync(u => u.username == userName);
            employeeId = utente.id;

            var today = DateTime.Today;
            assignedVehicle = await dbContext.AssegnazioniVeicolo
                .Include(a => a.Veicolo)
                .FirstOrDefaultAsync(a =>
                    a.dipendente_id == employeeId &&
                    a.data_inizio.Date <= today &&
                    (a.data_fine == null || a.data_fine.Value.Date >= today)
                );

            if (assignedVehicle != null)
            {
                consumptionExists = await dbContext.ConsumiGiornalieri
                    .AnyAsync(c =>
                        c.v_id == assignedVehicle.Veicolo!.v_id &&
                        c.dipendente_id == employeeId &&
                        c.data_log == today
                    );
            }

            var deliveries = await dbContext.Consegne
                .Where(c =>
                    c.dipendente_id == employeeId &&
                    c.data_prevista == today
                )
                .OrderBy(c => c.orario_previsto ?? TimeSpan.MaxValue)
                .Select(c => c.indirizzo_dest)
                .ToListAsync();

            todaysDestinations = deliveries.Take(5).ToList();
            hasMoreDestinations = deliveries.Count > 5;
        }

        if (user.IsInRole("superadmin"))
        {
            totalUsers = await dbContext.utenti.CountAsync();
            superadminCount = await dbContext.utenti.CountAsync(u => u.ruolo == "superadmin");
            adminCount = await dbContext.utenti.CountAsync(u => u.ruolo == "admin");
            dipendenteCount = await dbContext.utenti.CountAsync(u => u.ruolo == "dipendente");
            clienteCount = await dbContext.utenti.CountAsync(u => u.ruolo == "cliente");
        }

        if (user.IsInRole("admin"))
        {
            await LoadVehicleStatsAsync();
            ComputeMaintenanceStats();
            LoadDeliveryStats();
        }

        if (user.IsInRole("cliente"))
        {
            await LoadClienteAsync();
        }
    }

    private async Task LoadClienteAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name!;
        var u = await dbContext.utenti.SingleAsync(u => u.username == userName);
        customerId = u.id;

        var today = DateTime.Today;
        var all = await dbContext.Consegne
            .Include(c => c.Dipendente)
            .Where(c => c.cliente_id == customerId)
            .ToListAsync();

        pastDeliveries = all
            .Where(c => c.data_prevista.Date < today)
            .OrderByDescending(c => c.data_prevista)
            .ToList();

        todaysDeliveries = all
            .Where(c => c.data_prevista.Date == today)
            .OrderBy(c => c.orario_previsto ?? TimeSpan.MaxValue)
            .ToList();

        futureDeliveries = all
            .Where(c => c.data_prevista.Date > today)
            .OrderBy(c => c.data_prevista)
            .ToList();
    }

    private async Task LoadVehicleStatsAsync()
    {
        var veicoli = await dbContext.Veicoli.ToListAsync();
        totalVehicles = veicoli.Count;
        var stati = new[]
        {
            ("deposito","Deposito","bg-secondary"),
            ("fuori deposito","Fuori deposito","bg-warning text-dark"),
            ("manutenzione","Manutenzione","bg-danger")
        };
        vehicleStats = stati.Select(s =>
        {
            var cnt = veicoli.Count(v => v.stato_corrente == s.Item1);
            var pct = totalVehicles > 0 ? cnt * 100.0 / totalVehicles : 0;
            return new StatItem { Label = s.Item2, Percent = pct, BarClass = s.Item3 };
        }).ToList();
    }

    private void ComputeMaintenanceStats()
    {
        var vehicles = dbContext.Veicoli.Include(v => v.Manutenzioni).ToList();
        var today = DateTime.Today;
        var total = vehicles.Count;
        countOverdue = vehicles.Count(v => v.Manutenzioni.Any(m => m.data_intervento.Date < today && !m.is_completed));
        countDueToday = vehicles.Count(v => !v.Manutenzioni.Any(m => m.data_intervento.Date < today && !m.is_completed)
                       && v.Manutenzioni.Any(m => m.data_intervento.Date == today && !m.is_completed));
        countNoFuture = vehicles.Count(v => !v.Manutenzioni.Any(m => m.data_intervento.Date < today && !m.is_completed)
                       && !v.Manutenzioni.Any(m => m.data_intervento.Date == today && !m.is_completed)
                       && !v.Manutenzioni.Any(m => m.data_intervento.Date > today));
        countFutureProgrammed = total - (countOverdue + countDueToday + countNoFuture);

        percentOverdue = total > 0 ? countOverdue * 100.0 / total : 0;
        percentDueToday = total > 0 ? countDueToday * 100.0 / total : 0;
        percentNoFuture = total > 0 ? countNoFuture * 100.0 / total : 0;
        percentFutureProgrammed = total > 0 ? countFutureProgrammed * 100.0 / total : 0;
    }

    private void LoadDeliveryStats()
    {
        var deliveries = dbContext.Consegne.ToList();
        totalDeliveries = deliveries.Count;
        var statuses = new[] { "in preparazione", "in consegna", "consegnato" };
        deliveryStats = statuses.Select(s =>
        {
            var cnt = deliveries.Count(d => d.stato == s);
            var pct = totalDeliveries > 0 ? cnt * 100.0 / totalDeliveries : 0;
            return new StatItem { Label = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s), Percent = pct };
        }).ToList();
    }

    private class StatItem
    {
        public string Label { get; set; } = "";
        public double Percent { get; set; }
        public string BarClass { get; set; } = "";
    }
}
