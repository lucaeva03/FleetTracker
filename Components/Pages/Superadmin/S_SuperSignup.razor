@page "/S_super_signup"
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering]
@attribute [Authorize(Roles = "superadmin")]

@using FleetTracker
@using FleetTracker.Data
@using FleetTracker.Models.Events
@using System.ComponentModel.DataAnnotations
@using static BCrypt.Net.BCrypt

@inject FleetTrackerDbContext dbContext
@inject NavigationManager navigationManager

<PageTitle>Creazione Account - FleetTracker</PageTitle>

<div class="login-page d-flex flex-column justify-content-center align-items-center">

    <div class="login-box bg-white shadow rounded-4">
        <div class="text-center mb-3">
            <h2 class="fw-bold">Crea un nuovo account</h2>
            <p class="text-muted">Utilizza questo modulo per creare account destinati a dipendenti e responsabili</p>
        </div>

        <EditForm Model="@Model" OnValidSubmit="Register" @onsubmit:preventDefault FormName="SignUpForm">
            <DataAnnotationsValidator />

            <div class="form-grid">
                <div>
                    <label class="form-label">Username</label>
                    <InputText @bind-Value="Model.Username" class="form-control" placeholder="Inserisci username" />
                    <ValidationMessage For="@(() => Model.Username)" />
                </div>

                <div>
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="Model.Email" class="form-control" placeholder="Inserisci email" />
                    <ValidationMessage For="@(() => Model.Email)" />
                </div>

                <div>
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="Model.Password" type="password" class="form-control" placeholder="Inserisci password" />
                    <ValidationMessage For="@(() => Model.Password)" />
                </div>

                <div>
                    <label class="form-label">Conferma Password</label>
                    <InputText @bind-Value="Model.ConfirmPassword" type="password" class="form-control" placeholder="Conferma password" />
                    <ValidationMessage For="@(() => Model.ConfirmPassword)" />
                </div>

                <div class="col-span-2">
                    <label class="form-label">Ruolo</label>
                    <InputSelect @bind-Value="Model.Ruolo" class="form-control">
                        <option disabled value="">-- Seleziona ruolo --</option>
                        <option value="superadmin">Superadmin</option>
                        <option value="admin">Admin</option>
                        <option value="dipendente">Dipendente</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Model.Ruolo)" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger text-center">@errorMessage</div>
            }
            @if (success)
            {
                <div class="alert alert-success text-center">
                    Registrazione completata!
                </div>
            }

            <button type="submit" class="btn-login mt-3">Crea Account</button>
        </EditForm>
    </div>
</div>

<style>
    .login-page {
        min-height: 100vh;
        margin: 0; 
        font-family: 'Poppins', sans-serif;
        background: url('/images/BGLogin.png') no-repeat center center fixed;
        background-size: cover;
    }

    .login-box {
        max-width: 500px;
        width: 100%;
        background-color: #ffffff;
        border-radius: 2rem;
        padding: 2.5em 3em;
        box-shadow: 0 0 16px rgba(0, 0, 0, 0.1);
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem;
        border-radius: 0.5rem;
        border: 1px solid #ccc;
        font-size: 1rem;
    }

    .btn-login {
        background-color: #165a61;
        color: #ffffff;
        padding: 0.75rem;
        font-size: 1.1rem;
        font-weight: 500;
        border-radius: 2rem;
        transition: background-color 0.3s ease;
        border: none;
        width: 100%;
        margin-top: 1rem;
    }

        .btn-login:hover {
            background-color: #10474c;
        }

    .alert {
        padding: 0.75rem;
        margin-top: 1rem;
        border-radius: 0.5rem;
        font-size: 0.95rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem 2rem;
    }

    .col-span-2 {
        grid-column: span 2;
    }
</style>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private RegisterViewModel Model { get; set; } = new();

    private string? errorMessage;
    private bool success = false;

    public class PasswordStrengthAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value)
        {
            var password = value as string;
            if (string.IsNullOrWhiteSpace(password)) return false;

            var hasUpper = password.Any(char.IsUpper);
            var hasLower = password.Any(char.IsLower);
            var hasDigit = password.Any(char.IsDigit);
            var hasSymbol = password.Any(ch => !char.IsLetterOrDigit(ch));

            return hasUpper && hasLower && hasDigit && hasSymbol;
        }
    }

    private async Task Register()
    {
        try
        {
            var exists = dbContext.utenti.Any(u => u.username == Model.Username || u.email == Model.Email);
            if (exists)
            {
                errorMessage = "Username o email già in uso.";
                return;
            }

            var user = new Utenti
                {
                    username = Model.Username,
                    email = Model.Email,
                    password = HashPassword(Model.Password),
                    ruolo = Model.Ruolo
                };

            dbContext.utenti.Add(user);
            await dbContext.SaveChangesAsync();

            success = true;
            errorMessage = null;
            Model = new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore durante la registrazione: {ex.Message}";
        }
    }

    public class RegisterViewModel
    {
        [Required(ErrorMessage = "Username obbligatorio")]
        [RegularExpression("^[a-zA-Z0-9_]{3,20}$", ErrorMessage = "Consentiti solo lettere, numeri e underscore. Minimo 3 caratteri.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email obbligatoria")]
        [EmailAddress(ErrorMessage = "Formato email non valido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password obbligatoria")]
        [MinLength(6, ErrorMessage = "Minimo 6 caratteri")]
        [PasswordStrength(ErrorMessage = "La password deve contenere almeno una maiuscola, una minuscola, un numero e un simbolo")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Conferma password obbligatoria")]
        [Compare("Password", ErrorMessage = "Le password non coincidono")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ruolo obbligatorio")]
        [RegularExpression("^(superadmin|admin|dipendente)$", ErrorMessage = "Ruolo non valido")]
        public string Ruolo { get; set; } = string.Empty;
    }
}
