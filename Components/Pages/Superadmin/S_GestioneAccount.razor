@page "/S_gestione_account"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering]
@attribute [Authorize(Roles = "superadmin")]

@using System
@using System.Linq
@using Microsoft.EntityFrameworkCore
@using FleetTracker.Data
@using System.Globalization
@using FleetTracker.Models.Events
@inject FleetTrackerDbContext dbContext

<PageTitle>Gestione Account - FleetTracker</PageTitle>

<div class="user-management-page">
    <!-- Sidebar invariata -->
    <aside class="sidebar">
        <!-- Counters Card -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h6 class="card-title"><strong>Statistiche utenti</strong></h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Totale utenti
                        <span class="badge bg-primary rounded-pill">@totalUsers</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Superadmin
                        <span class="badge bg-danger rounded-pill">@superadminCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Admin
                        <span class="badge bg-warning text-dark rounded-pill">@adminCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Dipendenti
                        <span class="badge bg-success rounded-pill">@dipendenteCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Clienti
                        <span class="badge bg-info text-dark rounded-pill">@clienteCount</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Distribution Card -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-title"><strong>Distribuzione</strong></h6>
                @foreach (var item in new[]
                {
                ("Superadmin", superadminPercent, "bg-danger"),
                ("Admin", adminPercent, "bg-warning"),
                ("Dipendenti", dipendentePercent, "bg-success"),
                ("Clienti", clientePercent, "bg-info")
                })
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <small>@item.Item1</small>
                            <small>@item.Item2.ToString("0.##")%</small>
                        </div>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped @item.Item3"
                                 role="progressbar"
                                 style="@($"width:{item.Item2.ToString("0.##", CultureInfo.InvariantCulture)}%")"
                                 aria-valuenow="@item.Item2"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </aside>

    <!-- Main area: ricerca + lista utenti -->
    <main>
        <!-- Search Card -->
        <div class="search-main mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title"><strong>Ricerca utenti</strong></h6>
                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               placeholder="Cerca per username..."
                               @bind-value="searchTerm"
                               @bind-value:event="oninput" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Messaggio di errore se la cancellazione non è consentita -->
        @if (!string.IsNullOrEmpty(deleteErrorMessage))
        {
            <div class="alert alert-warning">
                @deleteErrorMessage
            </div>
        }

        <!-- Lista utenti con max 4 card visibili e scrollbar interna -->
        <section class="user-list custom-scroll">
            @if (FilteredUsers.Any())
            {
                @foreach (var user in FilteredUsers)
                {
                    <div class="card user-card shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <p class="m-0"><strong>Username:</strong> @user.username</p>
                                <p class="m-0"><strong>Email:</strong>    @user.email</p>
                                <p class="m-0"><strong>Ruolo:</strong>    @user.ruolo</p>
                            </div>
                            <button class="btn btn-danger delete-btn d-flex align-items-center justify-content-center"
                                    @onclick="() => ShowDeleteModal(user)">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Nessun utente trovato.</p>
            }
        </section>
    </main>
</div>

<!-- Modal di conferma -->
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i><strong>Conferma Eliminazione</strong></h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Sei sicuro di voler eliminare l'utente <strong>@userToDelete?.username</strong>?<br />
                        Questa operazione è irreversibile.
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Annulla</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">Elimina</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .page-title {
        text-align: center;
        margin: 1rem 0;
        font-size: 2.8rem;
        color: #165a61;
        text-shadow: -1px -1px 2px rgba(0,0,0,0.2), 1px 1px 2px rgba(0,0,0,0.2);
        font-family: 'Poppins', sans-serif;
    }

    .user-management-page {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 2rem;
        max-width: 1100px;
        margin: 0.5rem auto;
        padding: 2rem;
        background-color: #fafafa;
        border-radius: 1.5rem;
    }

    .sidebar .card {
        border: none;
        border-radius: 1rem;
    }

    .sidebar .card-title {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: #333;
    }

    .search-main .card {
        border: none;
        border-radius: 1rem;
    }

    .search-main .card-title {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: #333;
    }

    .user-list.custom-scroll {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: 30rem;
        overflow-y: auto;
        padding-right: 0.5rem;
    }

    .user-list.custom-scroll {
        scrollbar-width: thin;
        scrollbar-color: #ccc #f1f1f1;
    }

        .user-list.custom-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .user-list.custom-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .user-list.custom-scroll::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

            .user-list.custom-scroll::-webkit-scrollbar-thumb:hover {
                background: #b3b3b3;
            }

    .user-card {
        border-radius: 1rem;
    }

    .btn-outline-danger i {
        margin-right: 0.3rem;
    }

    .delete-btn {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .delete-btn i {
            font-size: 1.5rem;
        }
</style>

@code {
    private List<Utenti> utenti = new();
    private string searchTerm = string.Empty;
    private Utenti userToDelete;
    private bool showModal = false;
    private string deleteErrorMessage;

    private IEnumerable<Utenti> FilteredUsers =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? utenti
            : utenti.Where(u =>
                u.username.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private int totalUsers, superadminCount, adminCount, dipendenteCount, clienteCount;
    private double superadminPercent, adminPercent, dipendentePercent, clientePercent;

    protected override async Task OnInitializedAsync()
    {
        utenti = await dbContext.utenti.ToListAsync();
        await LoadStats();
    }

    private async Task LoadStats()
    {
        totalUsers = await dbContext.utenti.CountAsync();
        superadminCount = await dbContext.utenti.CountAsync(u => u.ruolo == "superadmin");
        adminCount = await dbContext.utenti.CountAsync(u => u.ruolo == "admin");
        dipendenteCount = await dbContext.utenti.CountAsync(u => u.ruolo == "dipendente");
        clienteCount = await dbContext.utenti.CountAsync(u => u.ruolo == "cliente");

        if (totalUsers > 0)
        {
            superadminPercent = superadminCount * 100.0 / totalUsers;
            adminPercent = adminCount * 100.0 / totalUsers;
            dipendentePercent = dipendenteCount * 100.0 / totalUsers;
            clientePercent = clienteCount * 100.0 / totalUsers;
        }
    }

    private void ShowDeleteModal(Utenti user)
    {
        userToDelete = user;
        deleteErrorMessage = null;
        showModal = true;
    }

    private void CancelDelete()
    {
        showModal = false;
        userToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (userToDelete != null)
        {
            try
            {
                dbContext.utenti.Remove(userToDelete);
                await dbContext.SaveChangesAsync();

                utenti.Remove(userToDelete);
                await LoadStats();
                deleteErrorMessage = null;
            }
            catch (DbUpdateException)
            {
                // Messaggio predefinito, indipendente dal tipo di relazione
                deleteErrorMessage = "L'utente non può essere eliminato perché è coinvolto in consegne/mansioni passate, attuali o future. Eliminale per consentire questa operazione.";
            }
        }

        showModal = false;
        StateHasChanged();
    }
}
