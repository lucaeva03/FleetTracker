@code {
    private List<Veicolo> veicoli = new();
    private List<Utenti> dipendenti = new();
    private List<AssegnazioneVeicolo> assignments = new();
    private HashSet<int> currentAssignedVehicleIds = new();
    private int totalVehicles;
    private List<StatItem> vehicleStats = new();
    private string searchTerm = "";

    private bool showAddModal, showDeleteModal, showAssignModal, showDeleteAssignModal;
    private Veicolo newVehicle = new() { km_totali = 0, data_acquisto = DateTime.Today, stato_corrente = "deposito" };
    private Veicolo vehicleToDelete;
    private AssegnazioneVeicolo newAssign = new() { data_inizio = DateTime.Today };
    private AssegnazioneVeicolo assignToDelete;
    private string assignError;
    private string addError;  

    private class StatItem
    {
        public string Label { get; set; }
        public double Percent { get; set; }
        public string BarClass { get; set; }
    }

    private IEnumerable<Veicolo> FilteredVehicles =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? veicoli
            : veicoli.Where(v => v.targa.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
        => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        // 1) Carico veicoli con manutenzioni e assegnazioni
        veicoli = await dbContext.Veicoli
            .Include(v => v.Manutenzioni)
            .Include(v => v.Assegnazioni)
            .OrderBy(v => v.targa)
            .ToListAsync();

        // 2) Carico lista dipendenti (per la modal di assegnazione)
        dipendenti = await dbContext.utenti
            .Where(u => u.ruolo == "dipendente")
            .OrderBy(u => u.username)
            .ToListAsync();

        // 3) Carico tutte le assegnazioni (per la tabella e per lo stato)
        assignments = await dbContext.AssegnazioniVeicolo
            .Include(a => a.Veicolo)
            .Include(a => a.Dipendente)
            .OrderByDescending(a => a.data_inizio)
            .ToListAsync();

        // 4) Trovo i veicoli assegnati “oggi”
        var today = DateTime.Today;
        currentAssignedVehicleIds = assignments
            .Where(a =>
                a.data_inizio.Date <= today &&
                (a.data_fine == null || a.data_fine.Value.Date >= today))
            .Select(a => a.v_id)
            .ToHashSet();

        // 5) Ricalcolo dinamico dello stato_corrente
        foreach (var v in veicoli)
        {
            if (currentAssignedVehicleIds.Contains(v.v_id))
            {
                v.stato_corrente = "fuori deposito";
            }
            else if (v.Manutenzioni.Any(m =>
                         m.data_intervento.Date == today && !m.is_completed))
            {
                v.stato_corrente = "manutenzione";
            }
            else
            {
                v.stato_corrente = "deposito";
            }
        }

        // 6) Ricalcolo delle statistiche veicolo
        totalVehicles = veicoli.Count;
        var stati = new[]
        {
        ("deposito",        "Deposito",        "bg-secondary"),
        ("fuori deposito",  "Fuori deposito",  "bg-warning"),
        ("manutenzione",    "Manutenzione",    "bg-danger")
    };
        vehicleStats = stati.Select(s =>
        {
            var cnt = veicoli.Count(v => v.stato_corrente == s.Item1);
            var pct = totalVehicles > 0 ? cnt * 100.0 / totalVehicles : 0;
            return new StatItem { Label = s.Item2, Percent = pct, BarClass = s.Item3 };
        }).ToList();
    }



    // Aggiungi veicolo...
    private void ShowAddModal()
    {
        newVehicle = new() { km_totali = 0, data_acquisto = DateTime.Today, stato_corrente = "deposito" };
        showAddModal = true;
    }
    private void CancelAdd() => showAddModal = false;

    // Elimina veicolo...
    private void ShowDeleteModal(Veicolo v) { vehicleToDelete = v; showDeleteModal = true; }
    private void CancelDelete() => showDeleteModal = false;
    private async Task ConfirmDeleteAsync()
    {
        if (vehicleToDelete != null)
        {
            dbContext.Veicoli.Remove(vehicleToDelete);
            await dbContext.SaveChangesAsync();
            showDeleteModal = false;
            await LoadAllAsync();
        }
    }

    // Aggiungi assegnazione con controllo sovrapposizioni
    private void ShowAssignModal()
    {
        assignError = "";
        newAssign = new() { data_inizio = DateTime.Today };
        showAssignModal = true;
    }
    private void CancelAssign() => showAssignModal = false;
    
    private async Task ConfirmAssignAsync()
    {
        assignError = "";

        // 1) Campi obbligatori: dipendente, veicolo e date
        if (newAssign.dipendente_id == 0 || newAssign.v_id == 0)
        {
            assignError = "Seleziona veicolo e dipendente.";
            return;
        }

        // 2) Date obbligatorie
        if (newAssign.data_inizio == default
            || !newAssign.data_fine.HasValue)
        {
            assignError = "Inserisci sia la data di inizio sia la data di fine.";
            return;
        }

        // 3) Verifica coerenza date
        if (newAssign.data_fine.Value < newAssign.data_inizio)
        {
            assignError = "La data di fine deve essere uguale o successiva alla data di inizio.";
            return;
        }

        // 4) Conflitto sul veicolo
        var conflictV = await dbContext.AssegnazioniVeicolo
            .Where(a => a.v_id == newAssign.v_id)
            .Where(a =>
                (a.data_fine == null || a.data_fine >= newAssign.data_inizio) &&
                (newAssign.data_fine.Value >= a.data_inizio))
            .AnyAsync();
        if (conflictV)
        {
            assignError = "Veicolo già assegnato nel periodo selezionato.";
            return;
        }

        // 5) Conflitto sul dipendente
        var conflictD = await dbContext.AssegnazioniVeicolo
            .Where(a => a.dipendente_id == newAssign.dipendente_id)
            .Where(a =>
                (a.data_fine == null || a.data_fine >= newAssign.data_inizio) &&
                (newAssign.data_fine.Value >= a.data_inizio))
            .AnyAsync();
        if (conflictD)
        {
            assignError = "Dipendente già impegnato nel periodo selezionato.";
            return;
        }

        // 6) Veicolo in manutenzione
        var manut = await dbContext.Manutenzioni
        .Where(m => m.v_id == newAssign.v_id)
        .Where(m => !m.is_completed)
        .Where(m =>
            m.data_intervento.Date >= newAssign.data_inizio.Date &&
            m.data_intervento.Date <= newAssign.data_fine.Value.Date)
        .OrderBy(m => m.data_intervento)
        .FirstOrDefaultAsync();

        if (manut != null)
        {
            assignError = $"Manutenzione del veicolo prevista per il giorno {manut.data_intervento:dd/MM/yyyy}.";
            return;
        }

        // 7) Se tutto ok, salvo
        dbContext.AssegnazioniVeicolo.Add(newAssign);
        await dbContext.SaveChangesAsync();
        showAssignModal = false;
        await LoadAllAsync();
        StateHasChanged();
    }

    private async Task ConfirmAddAsync()
    {
        addError = "";

        // 1) Targa e modello non vuoti
        if (string.IsNullOrWhiteSpace(newVehicle.targa) ||
            string.IsNullOrWhiteSpace(newVehicle.modello))
        {
            addError = "Targa e modello sono obbligatori.";
            return;
        }

        // 2) Anno immatricolazione ragionevole
        var anno = newVehicle.anno_immatricolazione;
        var oggi = DateTime.Today.Year;
        if (anno < 1900 || anno > oggi)
        {
            addError = $"Anno immatricolazione deve essere tra 1900 e {oggi}.";
            return;
        }

        // 3) KM ≥ 0
        if (newVehicle.km_totali < 0)
        {
            addError = "I KM totali non possono essere negativi.";
            return;
        }

        // 4) Stato selezionato
        if (string.IsNullOrEmpty(newVehicle.stato_corrente))
        {
            addError = "Seleziona uno stato per il veicolo.";
            return;
        }

        // 5) Data acquisto valida (non di default, non futura)
        if (newVehicle.data_acquisto == default ||
            newVehicle.data_acquisto > DateTime.Today)
        {
            addError = "Inserisci una data di acquisto valida (non nel futuro).";
            return;
        }

        // Se tutto ok, salvo
        dbContext.Veicoli.Add(newVehicle);
        await dbContext.SaveChangesAsync();

        showAddModal = false;
        await LoadAllAsync();
    }

    private bool IsVehicleUnavailable(int vId)
    {
        if (newAssign.data_inizio == default || !newAssign.data_fine.HasValue)
            return false;   // finché l’utente non ha scelto entrambe le date, lascia selezionare

        var start = newAssign.data_inizio.Date;
        var end = newAssign.data_fine.Value.Date;

        // verifica sovrapposizione con qualsiasi assegnazione esistente
        return assignments.Any(a =>
            a.v_id == vId
            && a.data_inizio.Date <= end
            && (a.data_fine == null || a.data_fine.Value.Date >= start)
        );
    }



    // Elimina assegnazione...
    private void ShowDeleteAssignModal(AssegnazioneVeicolo a) { assignToDelete = a; showDeleteAssignModal = true; }
    private void CancelDeleteAssign() => showDeleteAssignModal = false;
    private async Task ConfirmDeleteAssignAsync()
    {
        if (assignToDelete != null)
        {
            dbContext.AssegnazioniVeicolo.Remove(assignToDelete);
            await dbContext.SaveChangesAsync();
            showDeleteAssignModal = false;
            await LoadAllAsync();
            StateHasChanged();
        }
    }
}
