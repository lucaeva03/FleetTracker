@page "/A_gestione_veicoli"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FleetTracker.Data
@using FleetTracker.Models.Events
@using System.Linq
@using System.Globalization
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]
@inject FleetTrackerDbContext dbContext

<PageTitle>Gestione Veicoli - FleetTracker</PageTitle>

<div class="container-fluid vehicle-management-page py-4">
  <!-- Ricerca & Aggiungi -->
  <div class="row mb-4 align-items-center">
    <div class="col-md-8 mb-3 mb-md-0">
      <div class="input-group shadow-sm rounded-3 overflow-hidden">
        <span class="input-group-text bg-company border-0">
          <i class="bi bi-search text-white"></i>
        </span>
        <input class="form-control border-0" placeholder="Cerca per targa..." 
               @bind="searchTerm" @bind:event="oninput" />
      </div>
    </div>
    <div class="col-md-4 text-md-end">
      <button class="btn btn-company shadow-sm px-4 py-2" @onclick="ShowAddModal">
        <i class="bi bi-plus-lg me-1"></i> Aggiungi veicolo
      </button>
    </div>
  </div>

  <!-- Tabella Veicoli -->
  <div class="card shadow-sm border-0 rounded-3 mb-5">
    <div class="table-responsive" style="max-height: 45vh;">
      @if (FilteredVehicles.Any())
      {
        <table class="table table-hover table-striped align-middle mb-0">
          <thead class="table-light sticky-top">
            <tr>
              <th>Targa</th>
              <th>Modello</th>
              <th>Anno</th>
              <th>KM Totali</th>
              <th>Stato</th>
              <th>Acquisto</th>
              <th class="text-center">Azioni</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var v in FilteredVehicles)
            {
              <tr>
                <td class="fw-semibold text-company">@v.targa</td>
                <td>@v.modello</td>
                <td>@v.anno_immatricolazione</td>
                <td>@v.km_totali</td>
                <td>
                  <span class="badge bg-light text-company text-uppercase">
                    @v.stato_corrente
                  </span>
                </td>
                <td>@v.data_acquisto.ToString("dd/MM/yyyy")</td>
                <td class="text-center">
                  <button class="btn btn-outline-danger btn-sm" 
                          @onclick="() => ShowDeleteModal(v)" 
                          title="Elimina">
                    <i class="bi bi-trash-fill"></i>
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
      else
      {
        <div class="py-5">
          <p class="text-center text-muted mb-0">Nessun veicolo trovato.</p>
        </div>
      }
    </div>
  </div>

  <!-- Statistiche & Assegnazioni -->
  <div class="row g-4">
        <!-- Statistiche -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <h5 class="card-title text-company mb-4"><strong>Statistiche Veicoli</strong></h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Totale veicoli
                            <span class="badge bg-company rounded-pill">@totalVehicles</span>
                        </li>
                        @foreach (var stat in vehicleStats)
                        {
                            var icon = stat.Label switch
                            {
                                "Deposito" => "bi-building",
                                "Fuori deposito" => "bi-truck",
                                "Manutenzione" => "bi-wrench",
                                _ => "bi-bar-chart"
                            };

                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small><i class="bi @icon me-2"></i>@stat.Label</small>
                                    <small>@($"{stat.Percent:0.##}%")</small>
                                </div>
                                <div class="progress mt-2" style="height:6px; border-radius:4px;">
                                    <div class="progress-bar progress-bar-striped @stat.BarClass"
                                         role="progressbar"
                                         style="@($"width:{stat.Percent.ToString(CultureInfo.InvariantCulture)}%")"
                                         aria-valuenow="@stat.Percent"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>


    <!-- Assegnazioni -->
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-company"><strong>Assegnazione Veicoli</strong></h5>
        <button class="btn btn-outline-company" @onclick="ShowAssignModal">
          <i class="bi bi-link-45deg me-1"></i> Nuova Assegnazione
        </button>
      </div>
      <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive" style="max-height: 45vh;">
          @if (assignments.Any())
          {
            <table class="table table-hover table-striped align-middle mb-0">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Veicolo</th>
                  <th>Dipendente</th>
                  <th>Inizio</th>
                  <th>Fine</th>
                  <th class="text-center">Azioni</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var a in assignments)
                {
                  <tr>
                    <td class="fw-semibold text-company">@a.Veicolo!.targa</td>
                    <td>@a.Dipendente!.username</td>
                    <td>@a.data_inizio.ToString("dd/MM/yyyy")</td>
                    <td>@(a.data_fine?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td class="text-center">
                      <button class="btn btn-outline-danger btn-sm"
                              @onclick="() => ShowDeleteAssignModal(a)"
                              title="Rimuovi">
                        <i class="bi bi-trash-fill"></i>
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          }
          else
          {
            <div class="py-5">
              <p class="text-center text-muted mb-0">Nessuna assegnazione presente.</p>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Nuovo Veicolo -->
@if (showAddModal)
{
  <div class="modal-backdrop fade show"></div>
  <div class="modal fade show d-block" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content rounded-3 shadow-lg">
        <div class="modal-header bg-company text-white">
          <h5 class="modal-title"><i class="bi bi-truck me-2"></i>Nuovo Veicolo</h5>
          <button type="button" class="btn-close btn-close-white" @onclick="CancelAdd"></button>
        </div>
        <div class="modal-body">
          @if (!string.IsNullOrEmpty(addError))
          {
            <div class="alert alert-danger">@addError</div>
          }
          <div class="row g-3">
            <div class="col-md-6">
              <div class="form-floating">
                <input class="form-control border-company" id="inputTarga" @bind="newVehicle.targa" placeholder="Targa" />
                <label for="inputTarga">Targa</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                <input class="form-control border-company" id="inputModello" @bind="newVehicle.modello" placeholder="Modello" />
                <label for="inputModello">Modello</label>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-floating">
                <input type="number" class="form-control border-company" id="inputAnno"
                       @bind="newVehicle.anno_immatricolazione" placeholder="Anno" />
                <label for="inputAnno">Anno Immatricolazione</label>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-floating">
                <input type="number" class="form-control border-company" id="inputKm"
                       @bind="newVehicle.km_totali" placeholder="KM" />
                <label for="inputKm">KM Totali</label>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-floating">
                <select class="form-select border-company" id="selectStato" @bind="newVehicle.stato_corrente">
                  <option value="">-- Stato --</option>
                  <option value="deposito">Deposito</option>
                  <option value="fuori deposito">Fuori deposito</option>
                  <option value="manutenzione">Manutenzione</option>
                </select>
                <label for="selectStato">Stato</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                <input type="date" class="form-control border-company" id="dateAcquisto"
                       @bind="newVehicle.data_acquisto" placeholder="Data Acquisto" />
                <label for="dateAcquisto">Data Acquisto</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary" @onclick="CancelAdd">Annulla</button>
          <button class="btn btn-company" @onclick="ConfirmAddAsync">
            <i class="bi bi-check-lg me-1"></i>Salva
          </button>
        </div>
      </div>
    </div>
  </div>
}

<!-- Modal Elimina Veicolo -->
@if (showDeleteModal)
{
  <div class="modal-backdrop fade show"></div>
  <div class="modal fade show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-danger rounded-3">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Conferma Eliminazione</h5>
          <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
        </div>
        <div class="modal-body">
          Sei sicuro di voler eliminare il veicolo <strong>@vehicleToDelete?.targa</strong>?<br />
          Questa operazione è irreversibile.
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" @onclick="CancelDelete">Annulla</button>
          <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">Elimina</button>
        </div>
      </div>
    </div>
  </div>
}

<!-- Modal Nuova Assegnazione -->
@if (showAssignModal)
{
  <div class="modal-backdrop fade show"></div>
  <div class="modal fade show d-block" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content rounded-3 shadow-lg">
        <div class="modal-header bg-company text-white">
          <h5 class="modal-title"><i class="bi bi-link-45deg me-2"></i>Nuova Assegnazione</h5>
          <button type="button" class="btn-close btn-close-white" @onclick="CancelAssign"></button>
        </div>
        <div class="modal-body">
          @if (!string.IsNullOrEmpty(assignError))
          {
            <div class="alert alert-danger">@assignError</div>
          }
          <div class="row g-3">
            <div class="col-md-6">
              <div class="form-floating">
                <select class="form-select border-company" id="selectDipendente"
                        @bind="newAssign.dipendente_id">
                  <option value="0">-- Dipendente --</option>
                  @foreach (var d in dipendenti)
                  {
                    <option value="@d.id">@d.username</option>
                  }
                </select>
                <label for="selectDipendente">Dipendente</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                <select class="form-select border-company" id="selectVeicolo"
                        @bind="newAssign.v_id">
                  <option value="0">-- Veicolo --</option>
                    @foreach (var v in veicoli)
                    {
                        <option value="@v.v_id"
                                disabled="@IsVehicleUnavailable(v.v_id)">
                            @v.targa
                        </option>
                    }

                </select>
                <label for="selectVeicolo">Veicolo</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                <input type="date" class="form-control border-company" id="dateInizio"
                       @bind="newAssign.data_inizio" placeholder="Data Inizio" />
                <label for="dateInizio">Data Inizio</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                <input type="date" class="form-control border-company" id="dateFine"
                       @bind="newAssign.data_fine" placeholder="Data Fine (opzionale)" />
                <label for="dateFine">Data Fine (opzionale)</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-outline-secondary" @onclick="CancelAssign">Annulla</button>
          <button class="btn btn-company" @onclick="ConfirmAssignAsync">
            <i class="bi bi-check-lg me-1"></i>Assegna
          </button>
        </div>
      </div>
    </div>
  </div>
}

<!-- Modal Elimina Assegnazione -->
@if (showDeleteAssignModal)
{
  <div class="modal-backdrop fade show"></div>
  <div class="modal fade show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-danger rounded-3">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Conferma Rimozione</h5>
          <button type="button" class="btn-close btn-close-white" @onclick="CancelDeleteAssign"></button>
        </div>
        <div class="modal-body">
          Vuoi rimuovere l’assegnazione di 
          <strong>@assignToDelete?.Veicolo?.targa</strong> 
          al dipendente <strong>@assignToDelete?.Dipendente?.username</strong>?
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" @onclick="CancelDeleteAssign">Annulla</button>
          <button class="btn btn-danger" @onclick="ConfirmDeleteAssignAsync">Rimuovi</button>
        </div>
      </div>
    </div>
  </div>
}

